{
  "manifest_version": 3,
  "name": "viteCV Job Saver",
  "version": "0.2.0",
  "description": "Save jobs from career sites and see how your resume matches, in a side panel.",
  "action": {
    "default_title": "Open the viteCV panel"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": ["config.js", "html-to-text.js", "content/panel.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://vitecv-iota.vercel.app/*",
    "https://*/*",
    "http://*/*"
  ]
}
