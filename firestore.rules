rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A user owns everything under their own uid and nothing else.
    // This is the real data boundary: all resume reads and writes happen from
    // the browser with the client SDK, so these rules — not the session
    // cookie — are what keep one user's resumes away from another's.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Everything else is denied by default — no catch-all match below this.
  }
}
